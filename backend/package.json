{
  "name": "drawesome-backend",
  "version": "1.0.0",
  "description": "Azure Functions backend for Drawesome: passwordless sign-in (email code, Google, Microsoft) and drawing sync.",
  "private": true,
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "watch": "tsc --watch",
    "prestart": "npm run build",
    "start": "func start --cors http://localhost:5173"
  },
  "dependencies": {
    "@azure/communication-email": "^1.0.0",
    "@azure/cosmos": "^4.2.0",
    "@azure/functions": "^4.5.1",
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.26.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
